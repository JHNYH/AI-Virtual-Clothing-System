# AIWearPython 服务 / 工具脚本的环境变量模板
#
# 用法：复制本文件为 .env 后填入真实值。
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
#
# .env 已被 .gitignore 排除，请勿把真实凭据提交回仓库。

# ---- 阿里云百炼（DashScope）API Key ----
# 图片生成 / 分析 / 向量化都依赖它，留空则 AI 相关接口不可用。
DASHSCOPE_API_KEY=

# ---- Redis：检索向量索引 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- MySQL：tools/ 下的运维脚本使用 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bite
MYSQL_PASSWORD=
MYSQL_DATABASE=bite_wear

# ---- Python 服务自身地址（tools/reconcile_index.py 调用）----
PYTHON_SERVICE_URL=http://127.0.0.1:5000

# ---- 可选：推理相关 ----
# 关闭 CLIP 以节省内存（文搜图/图搜图将不可用）
CLIP_ENABLED=true
# PyTorch 线程数，默认压到单线程避免吃满 CPU
TORCH_NUM_THREADS=1

# 注意：CLIP 模型路径当前硬编码在 server.py 的 CLIP_MODEL_PATH（约第 57 行），
#      尚未走环境变量；换机器时需要直接改那一行。
