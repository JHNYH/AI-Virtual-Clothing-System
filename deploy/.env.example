# docker compose 会自动读取同目录下的 .env 文件（本文件是模板，复制为 .env 后填入真实值）
# .env 已被 .gitignore 排除，请勿把真实密码提交回仓库。
#
#   复制：cp .env.example .env       （Windows: Copy-Item .env.example .env）
#   启动：docker compose -p bite_wear -f docker-compose-mid.yml up -d

# MySQL root 密码，同时用于 docker-compose-mid.yml 的 healthcheck
MYSQL_ROOT_PASSWORD=
